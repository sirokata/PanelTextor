<Window x:Class="PanelTextor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewKeyDown="Window_KeyDown" Icon="Assets/PanelTextor.ico" Title="{DynamicResource Ui0}" Width="1380" Height="900" MinWidth="1050" MinHeight="650" Background="#F3F4F6">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="3"/></Style></Window.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Background="White">
   <WrapPanel Margin="8"><TextBlock Text="PanelTextor" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,20,0"/><Button Content="{DynamicResource Ui1}" Click="Import_Click"/><Button Content="{DynamicResource Ui2}" Click="New_Click"/><Button Content="{DynamicResource Ui3}" Click="Open_Click"/><Button Content="{DynamicResource Ui4}" Click="Save_Click"/><Button Content="{DynamicResource Ui5}" Click="SaveAs_Click"/><Button Content="{DynamicResource Ui6}" Click="Settings_Click"/><Button Content="{DynamicResource Ui7}" Click="ExportOne_Click"/><Button Content="{DynamicResource Ui8}" Click="ExportAll_Click"/><Button Content="{DynamicResource LicensesTitle}" Click="Licenses_Click"/></WrapPanel>
   <DockPanel Margin="12,0,12,8"><StackPanel Orientation="Horizontal"><Button x:Name="LanguageJP" Content="{DynamicResource Ui9}" Tag="JP" Click="Language_Click"/><Button x:Name="LanguageEN" Content="{DynamicResource Ui10}" Tag="EN" Click="Language_Click"/><Button x:Name="LanguageZH" Content="{DynamicResource Ui11}" Tag="ZH" Click="Language_Click"/><Button x:Name="LanguageKO" Content="{DynamicResource Ui12}" Tag="KO" Click="Language_Click"/><CheckBox x:Name="VisibleCheck" Content="{DynamicResource Ui13}" IsChecked="True" VerticalAlignment="Center" Margin="15,0" Click="Visibility_Click"/></StackPanel><TextBlock x:Name="LanguageLabel" Text="{DynamicResource Ui14}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
   <WrapPanel Margin="12,0,12,8"><TextBlock Text="Language:" VerticalAlignment="Center" Margin="3"/><ComboBox x:Name="InterfaceLanguage" Width="125" SelectedValuePath="Tag" SelectionChanged="InterfaceLanguage_Changed" Margin="5,0,12,0"><ComboBoxItem Content="日本語" Tag="JP"/><ComboBoxItem Content="English" Tag="EN"/><ComboBoxItem Content="简体中文" Tag="ZH"/><ComboBoxItem Content="한국어" Tag="KO"/></ComboBox><TextBlock Text="{DynamicResource Ui15}" VerticalAlignment="Center" Margin="3"/><ComboBox x:Name="BackgroundSets" Width="210" DisplayMemberPath="Name" SelectionChanged="Background_Changed" Margin="5,0"/><Button Content="{DynamicResource Ui16}" Click="AddSet_Click"/><Button Content="{DynamicResource Ui17}" Click="CheckSets_Click"/><Button Content="{DynamicResource Ui18}" Click="ImageInfo_Click"/></WrapPanel>
  </StackPanel>
  <ProgressBar x:Name="ExportMeter" DockPanel.Dock="Bottom" Height="18" Margin="12,0,12,6" Visibility="Collapsed" Minimum="0" Maximum="100"/><TextBlock x:Name="Status" DockPanel.Dock="Bottom" Padding="12,8" Text="{DynamicResource Ui19}"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <DockPanel Background="White" Margin="8"><TextBlock DockPanel.Dock="Top" Text="{DynamicResource Ui20}" FontWeight="Bold" Margin="10"/><WrapPanel DockPanel.Dock="Bottom"><Button Content="↑" Click="Up_Click"/><Button Content="↓" Click="Down_Click"/><Button Content="{DynamicResource Ui21}" Click="RemovePage_Click"/></WrapPanel><ListBox x:Name="PagesList" DisplayMemberPath="Name" SelectionChanged="Page_Changed" BorderThickness="0"/></DockPanel>
   <Grid Grid.Column="1" Margin="0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Ui22}" Click="Fit_Click"/><Button Content="−" Click="ZoomOut_Click"/><Button Content="＋" Click="ZoomIn_Click"/><TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" Margin="8"/></StackPanel><ScrollViewer x:Name="Viewport" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#32353B" SizeChanged="Viewport_Changed"><Canvas x:Name="Surface" Focusable="True" Background="White" Width="1" Height="1" ClipToBounds="True" MouseLeftButtonDown="Canvas_Down" MouseMove="Canvas_Move" MouseLeftButtonUp="Canvas_Up"/></ScrollViewer></Grid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8" Background="White"><StackPanel Margin="10">
<CheckBox x:Name="CameraEnabled" Content="{DynamicResource CameraFrameTitle}" Margin="3,6" Click="CameraEnabled_Click"/>
<StackPanel x:Name="CameraOptions">
<TextBlock Text="Battery:" Margin="3"/><UniformGrid x:Name="BatteryButtons" Columns="5"><Button Content="1" Tag="1" Click="Battery_Click"/><Button Content="2" Tag="2" Click="Battery_Click"/><Button Content="3" Tag="3" Click="Battery_Click"/><Button Content="4" Tag="4" Click="Battery_Click"/><Button Content="5" Tag="5" Click="Battery_Click"/></UniformGrid>
<StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource CameraTimeTitle}" VerticalAlignment="Center" Margin="3"/><TextBox x:Name="CameraTime" Width="115" TextChanged="CameraTime_Changed"/></StackPanel>
<TextBlock Text="{DynamicResource CameraPageHint}" TextWrapping="Wrap" Foreground="#666666" Margin="3,0,3,8"/>
</StackPanel><Separator Margin="0,5"/>
    <TextBlock Text="{DynamicResource Ui23}" FontWeight="Bold" FontSize="16"/><TextBlock Text="{DynamicResource Ui24}" Foreground="#666666" Margin="3,6"/><TextBox x:Name="BulkInput" Height="205" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Bulk_Changed"/><Button Content="{DynamicResource Ui25}" Click="AddBlocks_Click"/><Button Content="{DynamicResource ReplacementTitle}" Click="Replacement_Click"/><TextBlock Text="{DynamicResource Ui26}" Foreground="#666666" Margin="3,6"/>
    <Separator Margin="0,12"/><TextBlock x:Name="SelectionLabel" Text="{DynamicResource Ui27}" FontWeight="Bold" FontSize="16"/><TextBox x:Name="SelectedInput" Height="115" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Selected_Changed" IsEnabled="False"/>
    <TextBlock Text="{DynamicResource Ui28}" Margin="3,10,3,3"/><UniformGrid Columns="3"><Button x:Name="SmallButton" Content="{DynamicResource Ui29}" Tag="small" Click="Size_Click"/><Button x:Name="MediumButton" Content="{DynamicResource Ui30}" Tag="medium" Click="Size_Click"/><Button x:Name="LargeButton" Content="{DynamicResource Ui31}" Tag="large" Click="Size_Click"/></UniformGrid>
    <TextBlock Text="{DynamicResource Ui32}" Margin="3,10,3,3"/><UniformGrid x:Name="ColorButtons" Columns="4"/>
    <TextBlock Text="{DynamicResource Ui33}" Margin="3,10,3,3"/><UniformGrid Columns="2"><Button x:Name="VerticalButton" Content="{DynamicResource Ui34}" Tag="vertical" Click="Direction_Click"/><Button x:Name="HorizontalButton" Content="{DynamicResource Ui35}" Tag="horizontal" Click="Direction_Click"/></UniformGrid><Button x:Name="DeleteButton" Content="{DynamicResource Ui36}" Click="Delete_Click" Margin="3,15"/>
    <TextBlock Text="{DynamicResource Ui37}" FontWeight="Bold"/><StackPanel Orientation="Horizontal"><Button Content="−" Tag="-4" Click="SpacingStep_Click"/><TextBox x:Name="SpacingInput" Width="90" Text="0" TextChanged="Spacing_Changed" IsEnabled="False"/><Button Content="＋" Tag="4" Click="SpacingStep_Click"/><Button Content="{DynamicResource Ui38}" Click="SpacingReset_Click"/></StackPanel><TextBlock x:Name="SpacingHint" Text="{DynamicResource Ui39}" TextWrapping="Wrap" Foreground="#666666" Margin="3,3,3,12"/>
    <TextBlock Text="{DynamicResource Ui40}" FontWeight="Bold"/><ListBox x:Name="BlocksList" SelectionMode="Extended" DisplayMemberPath="Label" SelectionChanged="Block_Changed" Height="150" Margin="3,8"/><TextBlock Text="{DynamicResource Ui41}" TextWrapping="Wrap" Foreground="#666666" Margin="3,10"/>
   </StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>









